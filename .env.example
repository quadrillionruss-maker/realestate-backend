# ─────────────────────────────────────────────
# Real Estate Sales Operations API
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────

# Server. Render/Railway inject PORT themselves — leave it unset there.
PORT=4000
NODE_ENV=development

# ── Required: the service refuses to boot without these ──

# Supabase — Settings → API. The SERVICE ROLE key bypasses RLS, so it is
# server-side only and must never reach a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign AND verify HS256 bearer tokens. This service now issues
# them (POST /api/auth/login) as well as verifying them; anything else signing
# tokens for this API must use the same secret. It also signs buyer-portal
# links, so changing it invalidates every session and every portal link.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-minimum-32-characters

# ── Optional ──

# Comma-separated browser origins allowed to call this API.
# localhost origins are permitted automatically when NODE_ENV != production.
# Example: ALLOWED_ORIGINS=https://realestate.yourdomain.com
ALLOWED_ORIGINS=

# Paystack — required only for installment payment links.
PAYSTACK_SECRET_KEY=

# OpenAI — powers the daily brief. Without it the brief still runs and falls
# back to a rule-based summary and drafts, marked generated_by: 'fallback'.
OPENAI_API_KEY=
OPENAI_BRIEF_MODEL=gpt-5.6-luna

# Private Storage bucket for allocation letters and receipts. Created on first
# use. These carry a buyer's name and what they paid, so it is never public and
# is served only through short-lived signed URLs.
RE_DOCUMENTS_BUCKET=re-documents

# PUBLIC bucket for unit floor plans, photos and site maps. Separate on
# purpose: a floor plan is marketing a rep sends by WhatsApp mid-call, a
# buyer's allocation letter is not.
RE_MEDIA_BUCKET=re-media

# PUBLIC bucket for the workspace logo — same reasoning as RE_MEDIA_BUCKET:
# it's embedded in a PDF <img> and shown in the browser, never signed.
RE_PUBLIC_ASSETS_BUCKET=public-assets

# Set true to skip scheduling the daily job (useful locally and in CI).
RE_DISABLE_CRON=
# Override the brief schedule. Default: 07:00 Africa/Lagos.
RE_BRIEF_CRON=
# The second, marking-only sweep, just after the due-date cutoff below.
# Default: 18:05 Africa/Lagos.
RE_EVENING_SWEEP_CRON=

# ── Due dates ──
# An installment due on a date is due by this hour, Africa/Lagos. 18 = 6pm,
# close of business. One value for the whole workspace: two cutoffs is the same
# as none. Everything buyer-facing states it in words ("30 Jul 2026 by 6pm").
RE_DUE_CUTOFF_HOUR=18

# ── Sign-in ──

# Where the browser app is served from. Used to build password-reset links and
# buyer-portal links — both are useless if they point at the API instead of the
# UI. No trailing slash. Example: APP_URL=https://app.archta.com
APP_URL=

# How long a session lasts. Long enough that a working day never ends in a
# surprise logout.
JWT_EXPIRES_IN=30d

# Set to false once your team is onboarded to close the public sign-up form.
ALLOW_REGISTRATION=true

# "Sign in with Google". Create an OAuth 2.0 Web client in Google Cloud
# Console, add APP_URL to its authorized JavaScript origins, and paste the
# client ID here. Absent → the button is not rendered and no Google script is
# loaded at all.
GOOGLE_CLIENT_ID=

# Minutes a password-reset link stays valid.
RESET_TOKEN_TTL_MINUTES=60

# Require a confirmed email address before the API will serve /api/re.
# LEAVE BLANK unless you mean it: blank defaults to "on if RESEND_API_KEY and
# RESEND_FROM are both set". Forcing it true without working email means nobody
# can ever receive the link, so nobody can ever get in.
REQUIRE_EMAIL_VERIFICATION=
VERIFY_TOKEN_TTL_HOURS=48

# ── Buyer portal ──
# Days a buyer's self-service link stays valid. They sign in twice a year, so
# short links mean support calls. HARD-CAPPED AT 90 in code: revoking a link is
# a manual act, and the links that most need revoking — a dispute, a deal that
# fell through — are exactly the ones nobody remembers to revoke.
PORTAL_TOKEN_TTL_DAYS=60

# ── Notifications ──
# All optional. Without them, sends are recorded in re_notifications as
# 'skipped' rather than failing the request that triggered them — visible in
# Settings → Activity log rather than silently absent.

# Resend — receipts to buyers, missed-payment alerts to reps, password resets.
# RESEND_FROM must be an address on a domain you have verified with Resend.
RESEND_API_KEY=
RESEND_FROM=

# Termii — Nigerian SMS. Cheaper than Twilio for +234 traffic, local support.
# The sender ID must be registered with Termii before it will deliver.
TERMII_API_KEY=
TERMII_SENDER_ID=Archta

# ── Feature switches ──
# Auto-render a receipt PDF when a payment is recorded. Set false to keep
# payments working without it if PDF rendering is ever unavailable.
RE_AUTO_RECEIPTS=true

# Which Chromium pdfAdapter.js launches. Auto-detected by platform — Linux
# (Render) gets puppeteer-core + @sparticuz/chromium, anything else (local dev)
# gets full puppeteer. Leave blank unless diagnosing a deploy; "core" or "full"
# forces one path.
PDF_ENGINE=

# The API serves frontend/ at its root so `npm start` gives you the whole
# product at one URL. Set false if the frontend is deployed separately.
SERVE_FRONTEND=true
